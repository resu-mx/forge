# Copy to .env (`just setup` does this). Loaded by `just` via dotenv-load.

# SQLite database path (resolved to an absolute path by the justfile)
FORGE_DB_PATH=./data/forge.db

# Core API
FORGE_PORT=3000
FORGE_LOG_LEVEL=info

# Where MCP / CLI / webui proxy reach the API
FORGE_API_URL=http://localhost:3000

# CORS: which origins may call the API from a browser. Both servers (TS and Rust) read this.
# The API has no auth, so leave it unset unless a page on another origin has to call it directly.
#
#   unset (the default): dev allows only the web UI (http://localhost:5173 and
#       http://127.0.0.1:5173) and any chrome-extension:// or moz-extension:// origin;
#       production (NODE_ENV=production, or FORGE_ENV=production for the Rust server) allows any
#       origin.
#   a comma-separated list of exact origins: allows only those, in dev and in production, and
#       replaces the defaults above. List an extension exactly to allow just Forge's own, e.g.
#       FORGE_CORS_ORIGINS=http://localhost:4173,chrome-extension://<your-extension-id>
#       Entries are compared as written (case-sensitive); spaces and a trailing "/" are ignored.
#   "*": allows any origin.
#   blank: the same as unset.
# FORGE_CORS_ORIGINS=

# MCP server
# FORGE_MCP_TRANSPORT=stdio   # or http
# FORGE_MCP_PORT=5174
