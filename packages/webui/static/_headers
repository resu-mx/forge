# Cloudflare Pages headers for app.resu.mx (copied to the build root by SvelteKit).
# No COOP/COEP: OPFS sync access works in a dedicated Worker without SharedArrayBuffer
# (docs/src/dev/adrs/rust-wasm/0002).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # The Content-Security-Policy is not here: SvelteKit's hash mode (svelte.config.js) adds it to
  # the page, because the SPA fallback has an inline bootstrap script whose hash only the build
  # knows.

# Content-hashed build output never changes, so the ~9.5 MB gzipped Typst module is a one-time download.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
