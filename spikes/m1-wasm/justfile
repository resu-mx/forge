# THROWAWAY M1 spike recipes. Run with: just --justfile spikes/m1-wasm/justfile <recipe>
#
# SQLite is compiled from C for wasm32 by sqlite-wasm-rs, which needs a clang that
# has the WebAssembly backend. Apple clang does not; Homebrew LLVM does
# (`brew install llvm`). Override with LLVM_BIN=<dir containing clang and llvm-ar>.

cargo := "RUSTC=$(rustup which rustc --toolchain stable) rustup run stable cargo"
llvm := env("LLVM_BIN", "/opt/homebrew/opt/llvm@22/bin")

export PATH := env("HOME") / ".cargo/bin:" + env("PATH")
export CC_wasm32_unknown_unknown := llvm / "clang"
export AR_wasm32_unknown_unknown := llvm / "llvm-ar"

# Build the wasm and generate JS glue into web/pkg (needs `cargo install wasm-bindgen-cli`).
build:
    {{cargo}} build --release --target wasm32-unknown-unknown
    wasm-bindgen --target web --out-dir web/pkg target/wasm32-unknown-unknown/release/forge_m1_spike.wasm
    @ls -l web/pkg/forge_m1_spike_bg.wasm
    @gzip -9 -c web/pkg/forge_m1_spike_bg.wasm | wc -c | xargs echo "gzip -9 bytes:"

# Type-check only (fast).
check:
    {{cargo}} check --target wasm32-unknown-unknown

# Serve web/ on http://localhost:8137 (secure context, required by OPFS).
serve:
    python3 -m http.server -d web 8137
